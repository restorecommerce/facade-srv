{
  "name": "@restorecommerce/facade-srv",
  "version": "1.6.6",
  "description": "Restorecommerce facade service",
  "main": "./dist/start.cjs",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/facade-srv.git"
  },
  "license": "MIT",
  "keywords": [
    "restore",
    "commerce",
    "microservice",
    "facade",
    "srv"
  ],
  "type": "module",
  "dependencies": {
    "@restorecommerce/facade": "2.3.15",
    "@restorecommerce/logger": "1.4.4",
    "@restorecommerce/service-config": "1.2.4",
    "yamlparser": "^0.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@restorecommerce/dev": "^0.3.3",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.4",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "node ./dist/start.cjs",
    "lint": "eslint src",
    "purge": "rimraf dist coverage node_modules package-lock.json",
    "clean": "rimraf dist lib coverage",
    "prebuild": "npm-run-all clean lint",
    "build": "node esbuild.mjs",
    "dev": "cross-env NODE_ENV=development nodemon --watch './src/**/*.ts' --exec node --loader ts-node/esm ./src/start.ts",
    "pretest": "npm-run-all lint",
    "test": "cross-env NODE_ENV=test vitest run",
    "postinstall": "rm -rf ./node_modules/@josephg/resolvable/index.ts"
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/facade-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/facade-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
